---
import Base from "./Base.astro";

type Props = {
	heading: string;
	subheading?: string;
	description?: string;
};

const { heading, subheading, description } = Astro.props;
---

<Base title={`${heading} — linha.dev`} description={description}>
	<div class="flex justify-center items-start py-50 h-dvh">
		<div class="md:gap-7 flex-col flex gap-5 items-start justify-between">
			<div class="flex flex-col gap-2">
				<h1>{heading}</h1>
				{subheading && <h6 class="text-muted-foreground">{subheading}</h6>}
			</div>
			<div><slot /></div>
		</div>
	</div>
</Base>
