---
type Link = { title: string; href: string };
type Props = { prev?: Link; next?: Link };

const { prev, next } = Astro.props;
---

{(prev || next) && (
<nav class="pl-66">
	<div class="grid grid-cols-2 gap-8 border-t border-border pt-8">
		{prev ? (
				<a href={prev.href} class="flex flex-col gap-1">
					<span class="text-[13px] text-muted-foreground">← Předchozí</span>
					<span class="text-base/5.5 font-semibold text-foreground">{prev.title}</span>
				</a>
			) : (
				<div />
			)}
		{next && (
				<a href={next.href} class="flex flex-col gap-1 text-right">
					<span class="text-[13px] text-muted-foreground">Další →</span>
					<span class="text-base/5.5 font-semibold text-foreground">{next.title}</span>
				</a>
			)}
	</div>
</nav>
)}
