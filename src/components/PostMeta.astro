---
import { tagHref } from "../posts";
import Tag from "./Tag.astro";

type Props = { subject?: string; semester?: string; tags: string[] };

const { subject, semester, tags } = Astro.props;
const items = [
	{ key: "Předmět", value: subject },
	{ key: "Semestr", value: semester },
].filter((item) => item.value);
---

<aside
	class="flex w-50 flex-none flex-col gap-6 self-start border-t border-border pt-6"
>
	{items.map((item) => (
			<div class="flex flex-col gap-1">
				<span class="text-xs text-muted-foreground">{item.key}</span>
				<span class="text-sm/5 font-medium text-foreground">{item.value}</span>
			</div>
		))}
	<div class="flex flex-col gap-1">
		<span class="text-xs text-muted-foreground">Štítky</span>
		<div class="flex flex-wrap gap-1.5">
			{tags.map((tag) => <Tag href={tagHref(tag)}>{tag}</Tag>)}
		</div>
	</div>
</aside>
