---
import { getCollection } from "astro:content";
import Footer from "../components/Footer.astro";
import Tag from "../components/Tag.astro";
import TopBar from "../components/TopBar.astro";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("kisk")).sort(
	(a, b) => a.data.number - b.data.number,
);
---

<Base
	title="KISK Portfolio — linha.dev"
	description="Aneb jak jsem studoval v Brně"
>
	<div class="flex min-h-dvh flex-col items-center">
		<TopBar back={false} />
		<main class="flex w-236 flex-1 flex-col gap-14 pt-24">
			<header class="flex flex-col gap-2 pl-66">
				<h1>KISK Portfolio</h1>
				<p class="text-muted-foreground">Aneb jak jsem studoval v Brně</p>
			</header>
			<ul class="flex flex-col">
				{posts.map((post) => (
						<li class="flex gap-16 border-t border-border py-8">
							<div class="flex w-50 flex-none flex-col gap-1">
								<span class="text-xs font-medium tracking-[1.2px] text-muted-foreground">
									Příspěvek {String(post.data.number).padStart(2, "0")}
								</span>
								<span class="text-sm/5 font-medium text-foreground">
									{post.data.semester}
								</span>
							</div>
							<a href={`/kisk/${post.id}`} class="group flex flex-1 flex-col gap-2">
								<span class="text-2xl/8 font-bold tracking-[-0.4px] group-hover:text-primary">
									{post.data.title}
								</span>
								{post.data.subtitle && (
										<span class="text-muted-foreground">{post.data.subtitle}</span>
									)}
								<span class="flex flex-wrap gap-1.5 pt-2">
									{post.data.tags.map((tag) => <Tag>{tag}</Tag>)}
								</span>
							</a>
						</li>
					))}
			</ul>
		</main>
		<Footer />
	</div>
</Base>
